{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-right": ["cpu", "memory", "battery", "clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "states": { "warning": 60, "critical": 85 }
    },
    "memory": {
        "format": "RAM {percentage}%",
        "interval": 5,
        "states": { "warning": 70, "critical": 90 }
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "states": { "warning": 30, "critical": 15 }
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "{calendar}"
    },
    "tray": {
        "spacing": 8
    }
}
